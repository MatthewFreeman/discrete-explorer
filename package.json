{
  "name": "xds-ten-year-emission-explorer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vite dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vite build",
    "pages:build": "cross-env GITHUB_PAGES=true next build",
    "explorer:build": "cross-env STATIC_EXPORT=true DEPLOY_BASE_PATH=/emission NEXT_PUBLIC_SITE_URL=https://explorer.discrete.cash/emission/ NEXT_PUBLIC_EXPLORER_HOME=https://explorer.discrete.cash/ node scripts/build-explorer-export.mjs",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "generate:emission": "node scripts/generate-emission-decade.mjs",
    "verify:emission": "node scripts/verify-emission.mjs",
    "test": "npm run verify:emission && npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.36",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "miniflare": "5.20261006.0-alpha",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vinext": "1.0.1",
    "vite": "8.3.3",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "fflate": "0.7.5",
    "sharp": "0.35.5"
  },
  "type": "module"
}
